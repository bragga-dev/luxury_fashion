{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::luxuryfashionmedia",
        "arn:aws:s3:::luxuryfashionmedia/*",
        "arn:aws:s3:::luxuryfashionprivate",
        "arn:aws:s3:::luxuryfashionprivate/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::luxuryfashionstatic",
        "arn:aws:s3:::luxuryfashionstatic/*"
      ]
    }
  ]
}